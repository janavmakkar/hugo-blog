[Unit]
Description=DSA pattern practice Telegram bot
Documentation=file://__LEETCODE_DIR__/README.md
After=network-online.target
Wants=network-online.target
# Long polling reconnects on its own; only give up if it dies in a tight loop.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=__LEETCODE_DIR__
ExecStart=__LEETCODE_DIR__/.venv/bin/python -m bot.app
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
