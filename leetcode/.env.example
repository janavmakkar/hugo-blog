# Copy to leetcode/.env and fill in. setup.sh does this for you.
# chmod 600 - this file holds the bot token.

# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# Your own chat id; the bot ignores every other chat.
# Find it with: .venv/bin/python -m bot.whoami
TELEGRAM_CHAT_ID=

# When the daily prompt fires.
TIMEZONE=Asia/Kolkata
DAILY_HOUR=4
DAILY_MINUTE=0
DAILY_COUNT=2

# Publishing
SITE_BASE_URL=https://janav.in
AUTO_PUSH=1
GIT_BRANCH=main
POST_COVER=posts/otter_basic_dsa.jpg

# The same problem appears under several patterns in the sheet.
# 1 = solving it once clears all of its entries.
MIRROR_DUPLICATES=1
